{
	"name": "aws-lwf1",
	"private": true,
	"type": "module",
	"module": "src/index.ts",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"start": "bun src/index.ts",
		"build": "bun build src/index.ts --outdir=dist --target=node --format=esm --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
		"preview": "node dist/index.js",
		"typecheck": "bun check",
		"check": "bun check",
		"lint": "tsc --noEmit",
		"format": "oxfmt",
		"login": "aws login",
		"login-remote": "aws login --remote",
		"deploy": "aws lambda-web deploy --name aws-lwf1 --code ./dist",
		"delete": "aws lambda-web delete-web-function --function-name aws-lwf1"
	},
	"dependencies": {
		"express": "^5.3.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/express": "^5.0.6"
	},
	"peerDependencies": {
		"typescript": "^7.0.2"
	}
}
